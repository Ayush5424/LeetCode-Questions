class Solution {
    public boolean isBipartite(int[][] graph) {
        int[] color = new int[graph.length];
        for(int i = 0; i < color.length; i++){
            color[i] = -1;
        }    
        Queue<Integer> q = new LinkedList<>();
        for(int i = 0; i < color.length; i++){
            if(color[i] == -1){
                q.offer(i);
                color[i] = 0;

                while(!q.isEmpty()){
                    int curr = q.poll();
                    for(int n : graph[curr]){
                        if(color[n] == -1){
                            int nextCol = color[curr] == 0? 1 : 0;
                            color[n] = nextCol;
                            q.add(n); 
                        }
                        else if(color[n] == color[curr]){
                            return false;
                        }
                    }
                }
            }
        }
        return true;
    }
}
