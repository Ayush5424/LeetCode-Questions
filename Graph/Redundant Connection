class Solution {

    int[] parent;

    public int find(int x) {
        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }

        return parent[x];
    }

    public int[] findRedundantConnection(int[][] edges) {

        int n = edges.length;

        parent = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            parent[i] = i;
        }

        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            int p1 = find(u);
            int p2 = find(v);

            if (p1 == p2) {
                return edge;
            }

            parent[p1] = p2;
        }

        return new int[0];
    }
}
