class Solution {
    public List<Integer> rightSideView(TreeNode root) {
        List<Integer> ans = new ArrayList<>();
        Queue<TreeNode> nodes = new LinkedList<>();
        if (root == null) {
            return ans;
        }
        nodes.offer(root);
        while (!nodes.isEmpty()) {
            int size = nodes.size();
            for (int i = 0; i < size; i++) {
                TreeNode n = nodes.poll();
                if (i == size - 1) {
                    ans.add(n.val);
                }
                if (n.left != null) {
                    nodes.offer(n.left);
                }
                if (n.right != null) {
                    nodes.offer(n.right);
                }

            }
        }
        return ans;
    }
}
