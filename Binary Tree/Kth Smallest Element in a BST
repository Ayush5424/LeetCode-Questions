class Solution {
    public int kthSmallest(TreeNode root, int k) {
     List<Integer> res = new ArrayList<>();
     inorder(root, res);
     return res.get(k-1); 
    }
    public void inorder(TreeNode root, List<Integer> res){
        if(root == null){
            return;
        }
        inorder(root.left, res);
        res.add(root.val);
        inorder(root.right, res);
    }
}
