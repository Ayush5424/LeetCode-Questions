class Solution {
    int ans = Integer.MAX_VALUE;
    TreeNode prev = null;

    public int minDiffInBST(TreeNode root) {
        inorder(root);
        return ans;
    }

    public void inorder(TreeNode root) {
        if (root == null) {
            return;
        }

        inorder(root.left);

        if (prev != null) {
            ans = Math.min(ans, root.val - prev.val);
        }

        prev = root;

        inorder(root.right);
    }
}
