class Solution {
    public boolean isMiddleElementUnique(int[] nums) {

        int st = 0;
        int end  = nums.length-1;
        int mid = st + (end - st) / 2;

        Map<Integer,Integer> map = new HashMap<>();
        for(int i = 0; i < nums.length; i++){
            map.put(nums[i], map.getOrDefault(nums[i],0)+1);
        }
        int el = nums[mid];
        if(map.get(el) == 1){
            return true;
        }
        return false;
    }
}
