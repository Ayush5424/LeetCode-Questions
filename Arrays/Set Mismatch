class Solution {
    public int[] findErrorNums(int[] nums) {
        int[] freq = new int[nums.length+1];
        int[] rep = new int[2];

        for(int num : nums){
            freq[num]++;
        }

        for(int i = 1; i <= nums.length; i++){
            if(freq[i] == 2){
                rep[0] = i;
            }
            else if(freq[i] == 0){
                rep[1] = i;
            }
        }
        return rep;
    }
}
