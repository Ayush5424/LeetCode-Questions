class Solution {
    private static final int MOD = 1_000_000_007;

    private int[] sum;
    private int[] squareSum;
    private int[] lazy;
    private int n;

    public int sumCounts(int[] nums) {
        n = nums.length;

        sum = new int[4 * n];
        squareSum = new int[4 * n];
        lazy = new int[4 * n];

        int[] last = new int[100001];
        long answer = 0;

        for (int i = 0; i < n; i++) {
            int x = nums[i];
            int previous = last[x] - 1;

            update(1, 0, n - 1, previous + 1, i);

            answer = (answer + squareSum[1]) % MOD;

            last[x] = i + 1;
        }

        return (int) answer;
    }

    private void update(int node, int left, int right,
                        int ql, int qr) {
        if (ql > right || qr < left) {
            return;
        }

        if (ql <= left && right <= qr) {
            apply(node, left, right, 1);
            return;
        }

        pushDown(node, left, right);

        int mid = left + (right - left) / 2;

        update(node * 2, left, mid, ql, qr);
        update(node * 2 + 1, mid + 1, right, ql, qr);

        sum[node] = (int) (
            ((long) sum[node * 2] + sum[node * 2 + 1]) % MOD
        );

        squareSum[node] = (int) (
            ((long) squareSum[node * 2]
            + squareSum[node * 2 + 1]) % MOD
        );
    }

    private void apply(int node, int left, int right, int value) {
        long len = right - left + 1L;
        long add = value;

        squareSum[node] = (int) (
            (squareSum[node]
            + 2L * add * sum[node]
            + len * add * add) % MOD
        );

        sum[node] = (int) (
            (sum[node] + len * add) % MOD
        );

        lazy[node] += value;
    }

    private void pushDown(int node, int left, int right) {
        if (lazy[node] == 0 || left == right) {
            return;
        }

        int mid = left + (right - left) / 2;
        int value = lazy[node];

        apply(node * 2, left, mid, value);
        apply(node * 2 + 1, mid + 1, right, value);

        lazy[node] = 0;
    }
}
