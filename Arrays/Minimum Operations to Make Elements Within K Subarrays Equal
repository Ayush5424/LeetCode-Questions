
class Solution {

    TreeMap<Integer, Integer> left = new TreeMap<>();
    TreeMap<Integer, Integer> right = new TreeMap<>();

    long leftSum = 0;
    long rightSum = 0;

    int leftSize = 0;
    int rightSize = 0;

    void add(int num) {

        if (left.isEmpty() || num <= left.lastKey()) {
            left.put(num, left.getOrDefault(num, 0) + 1);
            leftSum += num;
            leftSize++;
        } else {
            right.put(num, right.getOrDefault(num, 0) + 1);
            rightSum += num;
            rightSize++;
        }

        balance();
    }

    void remove(int num) {

        if (left.containsKey(num)) {
            removeFrom(left, num);
            leftSum -= num;
            leftSize--;
        } else {
            removeFrom(right, num);
            rightSum -= num;
            rightSize--;
        }

        balance();
    }

    void removeFrom(TreeMap<Integer, Integer> map, int num) {
        if (map.get(num) == 1) {
            map.remove(num);
        } else {
            map.put(num, map.get(num) - 1);
        }
    }

    void balance() {

        while (leftSize > rightSize + 1) {
            int num = left.lastKey();

            removeFrom(left, num);
            leftSum -= num;
            leftSize--;

            right.put(num, right.getOrDefault(num, 0) + 1);
            rightSum += num;
            rightSize++;
        }

        while (leftSize < rightSize) {
            int num = right.firstKey();

            removeFrom(right, num);
            rightSum -= num;
            rightSize--;

            left.put(num, left.getOrDefault(num, 0) + 1);
            leftSum += num;
            leftSize++;
        }
    }

    long getCost() {

        long median = left.lastKey();

        return median * leftSize - leftSum
                + rightSum - median * rightSize;
    }

    public long minOperations(int[] nums, int x, int k) {

        int n = nums.length;
        int m = n - x + 1;

        long[] cost = new long[m];

        for (int i = 0; i < x; i++) {
            add(nums[i]);
        }

        cost[0] = getCost();

        for (int i = x; i < n; i++) {

            remove(nums[i - x]);
            add(nums[i]);

            cost[i - x + 1] = getCost();
        }

        long INF = Long.MAX_VALUE / 2;

        long[][] dp = new long[k + 1][n + 1];

        for (int i = 0; i <= k; i++) {
            Arrays.fill(dp[i], INF);
        }

        dp[0][0] = 0;

        for (int i = 0; i < n; i++) {

            for (int j = 0; j <= k; j++) {

                if (dp[j][i] == INF) {
                    continue;
                }

                dp[j][i + 1] = Math.min(
                    dp[j][i + 1],
                    dp[j][i]
                );

                if (j < k && i + x <= n) {

                    dp[j + 1][i + x] = Math.min(
                        dp[j + 1][i + x],
                        dp[j][i] + cost[i]
                    );
                }
            }
        }

        return dp[k][n];
    }
}
