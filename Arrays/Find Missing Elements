class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);
        List<Integer> l = new ArrayList<>();
        for(int i = 1; i < nums.length; i++){
            int diff = nums[i] - nums[i-1];
            if(diff > 1){
                for(int j = nums[i-1]+1; j < nums[i]; j++){
                    l.add(j);
                    
                }
            }
            
        }
        return l;
    }
}
