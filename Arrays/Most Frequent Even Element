class Solution {
    public int mostFrequentEven(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();

        for (int num : nums) {
            if (num % 2 == 0) {
                map.put(num, map.getOrDefault(num, 0) + 1);
            }
        }

        int max = -1;
        int maxFreq = 0;

        for (int x : map.keySet()) {
            if (map.get(x) > maxFreq ||
                (map.get(x) == maxFreq && x < max)) {

                maxFreq = map.get(x);
                max = x;
            }
        }

        return max;
    }
}
