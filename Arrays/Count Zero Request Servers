class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {
        Arrays.sort(logs, (a, b) -> a[1] - b[1]);

        int q = queries.length;
        Integer[] idx = new Integer[q];
        for (int i = 0; i < q; i++) idx[i] = i;
        Arrays.sort(idx, (a, b) -> queries[a] - queries[b]);

        int[] cnt = new int[n + 1];
        int active = 0, l = 0, r = 0;
        int[] res = new int[q];

        for (int id : idx) {
            int hi = queries[id], lo = hi - x;

            while (r < logs.length && logs[r][1] <= hi) {
                if (cnt[logs[r][0]]++ == 0) active++;
                r++;
            }
            while (l < r && logs[l][1] < lo) {
                if (--cnt[logs[l][0]] == 0) active--;
                l++;
            }
            res[id] = n - active;
        }
        return res;
    }
}
