class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {

        int k = flowerbed.length + 2;
        int[] res = new int[k];

        for (int i = 0; i < flowerbed.length; i++) {
            res[i + 1] = flowerbed[i];
        }

        for (int i = 1; i < res.length - 1; i++) {

            if (res[i - 1] == 0 && res[i] == 0 && res[i + 1] == 0) {
                res[i] = 1;
                n--;
            }

            if (n <= 0) {
                return true;
            }
        }

        return false;
    }
}
