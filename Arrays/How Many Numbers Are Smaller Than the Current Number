class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int[] result = new int[nums.length];
        for(int i = 0; i < result.length; i++){
            result[i] = 0;
        }
        for(int i = 0; i < nums.length; i++){
            int idx = i;
            for(int j = 0; j < nums.length; j++){
                if(nums[j] < nums[idx]){
                    result[i] += 1;
                }
            }
        }
        return result;
    }
}
