class Solution {
    public int missingMultiple(int[] nums, int k) {
        int n = nums.length;

        boolean[] arr = new boolean[n + 2];

        for (int i = 0; i < n; i++) {
            if (nums[i] % k == 0) {
                int idx = nums[i] / k;

                if (idx < arr.length) {
                    arr[idx] = true;
                }
            }
        }

        for (int i = 1; i < arr.length; i++) {
            if (!arr[i]) {
                return i * k;
            }
        }

        return -1;
    }
}
