class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode curr = head;
        ListNode prev = null;
        ListNode Next = null;
        if(head == null){
            return head;
        }
         while(curr != null){
            Next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = Next;
         }
         return prev;
    }
}
