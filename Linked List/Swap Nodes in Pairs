class Solution {
    public ListNode swapPairs(ListNode head) {
        ListNode dummy = new ListNode(-1);
        dummy.next = head;
        ListNode prev = dummy;
         
        while(prev.next != null && prev.next.next != null){
            ListNode slow = prev.next;
            ListNode fast = slow.next;
            
            slow.next = fast.next;
            fast.next = slow;
            prev.next = fast;

            prev = slow;
        }
       return dummy.next;  
    }
}
