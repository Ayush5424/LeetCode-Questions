class Solution {
    ArrayList<Integer> list;
    public Solution(ListNode head) {
        list = new ArrayList<>();
        while(head != null){
            list.add(head.val);
            head = head.next;
        }
    }
    
    public int getRandom() {
        int idx = (int)(Math.random()*list.size());
        return list.get(idx);
    }
}
