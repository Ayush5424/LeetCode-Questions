class Solution {
    public int[] shortestToChar(String s, char c) {
        int n = s.length();
        int[] res = new int[n];
        int c_position = -n;
        for (int i = 0; i < res.length; i++) {
            char ch = s.charAt(i);
            if (ch == c) {
                c_position = i;
            }

            res[i] = i - c_position;
        }
        for (int i = n - 1; i >= 0; i--) {
            char ch = s.charAt(i);
            if (ch == c) {
                c_position = i;
            }
            res[i] = Math.min(res[i], Math.abs(i - c_position));
        }
        return res;
    }
}
