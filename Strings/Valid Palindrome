class Solution {
    public boolean isPalindrome(String s) {

        if (s == null || s.length() == 0) {
            return true;
        }

        String str = s.toLowerCase();
        str = str.replaceAll("[^a-z0-9]", "");

        int ft = 0;
        int st = str.length() - 1;

        while (ft < st) {
            if (str.charAt(ft) != str.charAt(st)) {
                return false;
            }
            ft++;
            st--;
        }

        return true;
    }
}
