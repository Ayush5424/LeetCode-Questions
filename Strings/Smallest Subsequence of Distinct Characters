class Solution {
    public String smallestSubsequence(String s) {
        int n = s.length();
        int[] last = new int[26];

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);
            last[ch - 'a'] = i;
        }

        Set<Character> set = new HashSet<>();
        Stack<Character> st = new Stack<>();

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);

            if (set.contains(ch)) {
                continue;
            }

            while (!st.isEmpty() &&
                   st.peek() > ch &&
                   last[st.peek() - 'a'] > i) {
                set.remove(st.pop());
            }

            st.push(ch);
            set.add(ch);
        }

        StringBuilder ans = new StringBuilder();

        for (char ch : st) {
            ans.append(ch);
        }

        return ans.toString();
    }
}
