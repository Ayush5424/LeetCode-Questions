class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        Queue<Integer> line = new LinkedList<>();

        for (int i = 0; i < tickets.length; i++) {
            line.offer(i);
        }

        int timeNeeded = 0;

        while (!line.isEmpty()) {
            int person = line.poll();

            tickets[person]--;
            timeNeeded++;

            if (tickets[person] == 0) {
                if (person == k) {
                    return timeNeeded;
                }
            } else {
                line.offer(person);
            }
        }

        return timeNeeded;
    }
}